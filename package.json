{
  "name": "sound-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:demo": "CATALOG_MODE=demo next dev",
    "build": "npm run catalog:validate && next build",
    "build:demo": "CATALOG_MODE=demo npm run catalog:validate && CATALOG_MODE=demo next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "playwright test",
    "catalog:import": "tsx scripts/catalog-import.ts",
    "catalog:validate": "tsx scripts/catalog-validate.ts",
    "catalog:snapshot": "tsx scripts/catalog-snapshot.ts",
    "casos": "tsx scripts/casos-referencia.ts"
  },
  "dependencies": {
    "lz-string": "1.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
